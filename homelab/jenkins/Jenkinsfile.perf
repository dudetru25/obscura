// The fork folder pins the reviewed homelab library and source revision.
@Library('homelab') _

try {
    homelabPipeline(
        agentLabel: 'homelab-dev3-linux',
        branch: 'perf/e5-textarea',
        sourceRepository: 'https://github.com/dudetru25/obscura.git',
        scmCredentialId: scm.userRemoteConfigs[0].credentialsId,
        sourceRevisionParameter: 'SOURCE_SHA',
        scriptPath: 'homelab/jenkins/Jenkinsfile.perf',
        pipelineRevision: params.SOURCE_SHA,
        timeoutMinutes: 60,
        queueProfile: 'small-web',
        // Retained native packages: build 67 owns the base, build 72 the candidate.
        checkCommand: 'OBSCURA_BASE_PACKAGE=/mnt/g/GithubProjects/.jenkins-workspace/workspace/homelab-pilot/obscura-validation/committed-source@build-67/ci-output/obscura-9008b337bc299286e5216631a34d661fb00a0bf7-x86_64-linux.tar.gz ' +
            'OBSCURA_BASE_SHA256=c0b734d0fb027fab2e486348b2a5dc54aa1e66a79554d723d68dbc50dd7c8c63 ' +
            'OBSCURA_CANDIDATE_PACKAGE=/mnt/g/GithubProjects/.jenkins-workspace/workspace/homelab-pilot/obscura-validation/committed-source@build-72/ci-output/obscura-07f560a929988c89c6864ac34e19d67875004504-x86_64-linux.tar.gz ' +
            'OBSCURA_CANDIDATE_SHA256=280a8b7dc5b1eabb5663a1e640db89f0aeb54dfdce39312a431ec8d5ab579cf1 ' +
            'bash homelab/jenkins/jenkins-perf.sh'
    )
} finally {
    node('homelab-dev3-linux') {
        ws("${pwd()}@build-${env.BUILD_NUMBER}") {
            archiveArtifacts(artifacts: 'ci-output/**', excludes: 'ci-output/obscura-benchmark/**',
                allowEmptyArchive: true, fingerprint: true)
        }
    }
}
