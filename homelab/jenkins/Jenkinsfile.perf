// The fork folder pins the reviewed homelab library and source revision.
@Library('homelab') _

try {
    homelabPipeline(
        agentLabel: 'homelab-dev3-linux',
        branch: 'perf/e5-textarea',
        sourceRepository: 'https://github.com/dudetru25/obscura.git',
        scmCredentialId: scm.userRemoteConfigs[0].credentialsId,
        sourceRevisionParameter: 'SOURCE_SHA',
        scriptPath: 'homelab/jenkins/Jenkinsfile.perf',
        pipelineRevision: params.SOURCE_SHA,
        timeoutMinutes: 60,
        queueProfile: 'small-web',
        // Retained native packages: build 62 owns the base, build 67 the candidate.
        checkCommand: 'OBSCURA_BASE_PACKAGE=/mnt/g/GithubProjects/.jenkins-workspace/workspace/homelab-pilot/obscura-validation/committed-source@build-62/ci-output/obscura-1de5fa606e8447b5472d3e270467a348cac785bd-x86_64-linux.tar.gz ' +
            'OBSCURA_BASE_SHA256=a3f4e71794e67c8513cb909fccc1e3b0b8e9a45ad96f22f544872dd357d05721 ' +
            'OBSCURA_CANDIDATE_PACKAGE=/mnt/g/GithubProjects/.jenkins-workspace/workspace/homelab-pilot/obscura-validation/committed-source@build-67/ci-output/obscura-9008b337bc299286e5216631a34d661fb00a0bf7-x86_64-linux.tar.gz ' +
            'OBSCURA_CANDIDATE_SHA256=c0b734d0fb027fab2e486348b2a5dc54aa1e66a79554d723d68dbc50dd7c8c63 ' +
            'bash homelab/jenkins/jenkins-perf.sh'
    )
} finally {
    node('homelab-dev3-linux') {
        ws("${pwd()}@build-${env.BUILD_NUMBER}") {
            archiveArtifacts(artifacts: 'ci-output/**', excludes: 'ci-output/obscura-benchmark/**',
                allowEmptyArchive: true, fingerprint: true)
        }
    }
}
